/// Plantilla de configuración de claves API.
/// Copia este archivo como app_secrets.dart y completa los valores.
/// app_secrets.dart está en .gitignore: nunca se sube al repositorio.
///
/// IMPORTANTE: nada de lo que escribas aquí es secreto. Todo lo que quede en
/// este archivo se compila DENTRO del APK y se puede extraer descompilando.
/// Las llaves de pago van por --dart-define al compilar (ver abajo) y aquí
/// solo queda su valor por defecto vacío.
class AppSecrets {
  static const String mapboxToken = 'TU_TOKEN_MAPBOX_AQUI';
  static const String algoliaAppId = 'TU_APP_ID_ALGOLIA';
  static const String algoliaSearchKey = 'TU_SEARCH_KEY_ALGOLIA';
  static const String algoliaSyncKey = 'TU_SYNC_KEY_ALGOLIA';

  /// Se sobrescriben con --dart-define. Ejemplo de compilación:
  ///
  ///   flutter build apk --release \
  ///     --dart-define=GEMINI_API_KEY=tu_llave \
  ///     --dart-define=GROQ_API_KEY=tu_llave
  static const String geminiApiKey = String.fromEnvironment('GEMINI_API_KEY');
  static const String groqSyncKey = String.fromEnvironment('GROQ_API_KEY');
}
